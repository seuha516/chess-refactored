{
  "name": "chess-refactored",
  "version": "2.1.0",
  "private": true,
  "description": "1대1 체스 웹 애플리케이션",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.client.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "vercel-build": "vite build && node scripts/build-vercel.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seuha516/chess-refactored.git"
  },
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
